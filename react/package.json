{
  "name": "@spicychicken/react",
  "version": "2.2.0",
  "private": true,
  "license": "MIT",
  "description": "React bindings for the SpicyChicken design system (sc.css). Thin wrappers — the CSS is the source of truth. ESM only.",
  "type": "module",
  "module": "./dist/index.mjs",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "default": "./dist/index.mjs" },
    "./sc.css": "./dist/sc.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "scripts": {
    "gen:assets": "node scripts/gen-assets.mjs",
    "postinstall": "node scripts/gen-assets.mjs || exit 0",
    "build": "node scripts/gen-assets.mjs && tsc -p tsconfig.json && node scripts/build.mjs"
  },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
